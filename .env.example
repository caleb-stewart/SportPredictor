# FastAPI backend settings
DATABASE_URL=postgresql+psycopg2://postgres:qqqq@localhost:5432/sportpredictor_development
HOCKEYTECH_API=your_key_here
HOCKEYTECH_API_KEY_WHL=
HOCKEYTECH_API_KEY_OHL=
HOCKEYTECH_API_KEY_LHJMQ=
HOCKEYTECH_BASE_URL=https://lscluster.hockeytech.com/feed/
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Los_Angeles
LOCAL_MAINTENANCE_REFRESH_ENABLED=false
LOCAL_MAINTENANCE_MAX_CATCHUP_DAYS=14
MODEL_STORE_ROOT=model_store/whl_v2
API_PORT=3141
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Optional LAN-friendly regex for dev clients (phone/tablet) on private networks.
# Leave set unless you want to lock down origins further.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|[a-zA-Z0-9-]+(?:\.local)?|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?::\d+)?$
DATA_BACKEND=chl
DUAL_WRITE=false
DEFAULT_LEAGUE_CODE=whl
CHL_INGEST_MAX_WORKERS=6
CHL_INGEST_RPS_LIMIT=4
CHL_INGEST_RETRY_MAX=5
CHL_INGEST_TIMEOUT_SECONDS=30
WEEKLY_COMPARE_ENABLED=true
WEEKLY_COMPARE_BASELINE_MODEL_VERSION=20260217T025309Z
WEEKLY_COMPARE_LOOKBACK_DAYS=365
